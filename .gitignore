lerna-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr

# npm cache dir used by the Amplify build (amplify.yml: npm ci --cache .npm)
.npm/

# Environment files — never commit real secrets
.env
.env.*
!.env.example
*.local

# Amplify sandbox artifacts (local dev only)
.amplify/
.amplify-hosting/

# TypeScript build artifacts — source is .ts; these are generated by local ampx/tsc runs
amplify/**/*.js
amplify/**/*.js.map
src/**/*.js
src/**/*.js.map

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# tesseract.js language cache written by local scanner test runs
*.traineddata

# Scanned-invoice extractions: customer PII, never committed (TMS_BUILD_BRIEF.md)
invoice_extraction.json
invoice_ocr_raw.json

# Migration plan artifacts reviewed before --apply; kept out of the tree
plans/
